<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10/11, so the build output is a single exe with no runtime to install. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BatteryBrightness</AssemblyName>
    <RootNamespace>BatteryBrightness</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <Product>Battery Brightness</Product>
    <AssemblyTitle>Battery Brightness</AssemblyTitle>
    <Description>Separate screen brightness and refresh rate for battery and AC power.</Description>
    <GenerateAppConfig>false</GenerateAppConfig>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('app.ico')">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <!-- Lets any .NET SDK build this without the .NET Framework 4.8 developer pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
